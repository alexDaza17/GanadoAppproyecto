<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9F8">

    <!-- CABECERA -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B5E20"
        android:padding="20dp"
        android:orientation="vertical"
        android:elevation="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Nuevo recordatorio"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- INDICADOR DE PASOS -->
    <LinearLayout
        android:id="@+id/stepper"
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:gravity="center">
        <TextView android:layout_width="30dp" android:layout_height="30dp" android:text="1" android:background="@drawable/circle_green" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold"/>
        <View android:layout_width="40dp" android:layout_height="2dp" android:background="#E0E0E0"/>
        <TextView android:layout_width="30dp" android:layout_height="30dp" android:text="2" android:background="@drawable/circle_gray" android:textColor="#757575" android:gravity="center"/>
        <View android:layout_width="40dp" android:layout_height="2dp" android:background="#E0E0E0"/>
        <TextView android:layout_width="30dp" android:layout_height="30dp" android:text="3" android:background="@drawable/circle_gray" android:textColor="#757575" android:gravity="center"/>
    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_below="@id/stepper"
        android:layout_above="@id/contenedor_accion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA 1: VACUNA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💉 1. Información de la Vacuna" android:textStyle="bold" android:textColor="#1B5E20" android:textSize="16sp" android:layout_marginBottom="14dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nombre de la vacuna:" android:textSize="14sp" android:textColor="#424242" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <EditText
                        android:id="@+id/nombre_vacuna"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="#F1F8E9"
                        android:hint="Ej: Fiebre Aftosa, Brucelosis..."
                        android:paddingHorizontal="16dp"
                        android:textSize="15sp"
                        android:textColor="#212121"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="14dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Observaciones o dosis:" android:textSize="14sp" android:textColor="#424242" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <EditText
                        android:id="@+id/nota_vacuna"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="#F1F8E9"
                        android:hint="Ej: Aplicar en la mañana..."
                        android:padding="16dp"
                        android:gravity="top|start"
                        android:textSize="15sp"
                        android:textColor="#212121"
                        android:inputType="textMultiLine"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TARJETA 2: ANIMAL (CON NOMBRE Y FOTO) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📷 2. Identificación del Animal" android:textStyle="bold" android:textColor="#1B5E20" android:textSize="16sp" android:layout_marginBottom="14dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nombre de la vaca o toro:" android:textSize="14sp" android:textColor="#424242" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <EditText
                        android:id="@+id/nombre_animal"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="#F1F8E9"
                        android:hint="Ej: Lola, Manchas, Capitán..."
                        android:paddingHorizontal="16dp"
                        android:textSize="15sp"
                        android:textColor="#212121"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="14dp"/>

                    <ImageView
                        android:id="@+id/foto_vaca"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:background="#F1F8E9"
                        android:src="@android:drawable/ic_menu_camera"
                        android:scaleType="centerInside"
                        android:layout_marginBottom="14dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/boton_camara" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Cámara" android:backgroundTint="#2E7D32" android:textColor="#FFFFFF" android:layout_marginEnd="8dp" app:cornerRadius="25dp"/>
                        <Button android:id="@+id/boton_galeria" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Galería" android:backgroundTint="#37474F" android:textColor="#FFFFFF" app:cornerRadius="25dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TARJETA 3: FECHA Y HORA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅 3. Fecha y Hora de aplicación" android:textStyle="bold" android:textColor="#1B5E20" android:textSize="16sp" android:layout_marginBottom="14dp"/>

                    <CalendarView
                        android:id="@+id/calendario_vacunas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seleccione la hora de la alarma:"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TimePicker
                        android:id="@+id/reloj_vacuna"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:timePickerMode="spinner"
                        android:layout_gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- BOTÓN FIJO INFERIOR -->
    <LinearLayout
        android:id="@+id/contenedor_accion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="12dp">
        <Button
            android:id="@+id/boton_guardar_alarma"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Guardar y Programar Alarma"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B5E20"
            app:cornerRadius="30dp"/>
    </LinearLayout>
</RelativeLayout>