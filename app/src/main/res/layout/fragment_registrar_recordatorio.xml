<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etNombreVacuna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de la vacuna o control" />

    <EditText
        android:id="@+id/etFechaProxima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fecha de próxima aplicación"
        android:focusable="false"
        android:clickable="true"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnGuardarRecordatorio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Recordatorio"
        android:layout_marginTop="24dp" />

</LinearLayout>